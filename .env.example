# Database principale dell'app; default: ./data/cammini.sqlite
DB_FILE=./data/cammini.sqlite

# Solo per importare i dati da PostgreSQL con `npm run db:migrate-sqlite`.
DB_HOST=192.168.1.50
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=cammini_local
# In alternativa alle variabili DB_*:
# DATABASE_URL=postgresql://utente:password@host:5432/database
